# Core sources.  Each block lists its own files in rtl/<block>/<block>.qip.
# Vendored RTL (rtl/vendor; see rtl/vendor/MANIFEST.txt)
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vendor/k8000/k800x_cpu/gen/z8000_ctrl_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vendor/k8000/k800x_cpu/gen/z8000_zbus_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vendor/k8000/k800x_cpu/gen/z8000_mc_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vendor/k8000/k800x_cpu/gen/z8000_decode_rom_gen.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vendor/k8000/k800x_cpu/gen/z8000_mc_rom_gen.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vendor/k8000/k800x_cpu/z8000_alu.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vendor/k8000/k800x_cpu/z8000_bus_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vendor/k8000/k800x_cpu/z8000_cond.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vendor/k8000/k800x_cpu/z8000_decode.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vendor/k8000/k800x_cpu/z8000_execute.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vendor/k8000/k800x_cpu/z8000_int_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vendor/k8000/k800x_cpu/z8000_refresh.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vendor/k8000/k800x_cpu/z8000_regfile.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vendor/k8000/k800x_cpu/z8000_sequencer.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vendor/k8000/k800x_cpu/z8000_serial.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vendor/k8000/k800x_cpu/z8000_cpu.sv
set_global_assignment -name VERILOG_FILE rtl/vendor/c900/mc6845/mc6845_synth.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vendor/sdram/sdram.sv

# Common
set_global_assignment -name SYSTEMVERILOG_FILE rtl/common/c900_rst_sync.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/common/c900_sync2.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sdram/c900_sdram.sv

# Blocks
set_global_assignment -name QIP_FILE rtl/bus/bus.qip
set_global_assignment -name QIP_FILE rtl/video/video.qip
set_global_assignment -name QIP_FILE rtl/periph/periph.qip
set_global_assignment -name QIP_FILE rtl/fdc/fdc.qip
set_global_assignment -name QIP_FILE rtl/hdc/hdc.qip
set_global_assignment -name QIP_FILE rtl/exp/exp.qip
set_global_assignment -name QIP_FILE rtl/apb/apb.qip

# Machine top and shell
set_global_assignment -name SYSTEMVERILOG_FILE rtl/m20_core.sv
set_global_assignment -name SDC_FILE M20.sdc
set_global_assignment -name SYSTEMVERILOG_FILE M20.sv
